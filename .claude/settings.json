{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(task *)",
      "Bash(gh *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(kubectl *)",
      "Bash(oc *)",
      "Bash(helm *)",
      "Bash(kustomize *)",
      "Bash(kubeconform *)",
      "Bash(yamllint *)",
      "Bash(pre-commit *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform plan *)",
      "Bash(ansible-lint *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "WebFetch(domain:docs.redhat.com)",
      "WebFetch(domain:docs.cilium.io)",
      "WebFetch(domain:docs.openshift.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:azure.microsoft.com)",
      "WebFetch(domain:argo-cd.readthedocs.io)",
      "WebFetch(domain:kubevirt.io)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "ask": [
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(az aro create *)",
      "Bash(az aro delete *)",
      "Bash(az group delete *)",
      "Bash(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/pull-secret*)",
      "Read(./**/*.kubeconfig)",
      "Read(./**/kubeconfig)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",
      "Read(./infra/terraform/**/secrets.auto.tfvars)",
      "Read(~/.ssh/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Edit(./.git/**)",
      "Edit(./**/.env)",
      "Edit(./**/*.tfstate)",
      "WebFetch(domain:*.internal)",
      "WebFetch(domain:*.corp)"
    ],
    "additionalDirectories": []
  }
}
