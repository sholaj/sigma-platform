# Copy this file to terraform.tfvars and fill in the placeholders.
# terraform.tfvars is gitignored — never commit it.
#
# Look up sub + tenant IDs:
#   az account show --query id        -o tsv
#   az account show --query tenantId  -o tsv

subscription_id    = "00000000-0000-0000-0000-000000000000"
tenant_id          = "00000000-0000-0000-0000-000000000000"

location           = "uksouth"
cost_owner         = "sholaj"
monthly_budget_gbp = 500

# Comma-separated list of contact emails for budget alerts at 50/80/100%.
alert_emails       = ["you@example.com"]

# Used by the AAD app federated-credential setup in a later step.
github_org_repo    = "sholaj/sigma-platform"

# YYYY-MM-01 — first of the current month. Set once at apply time;
# the lifecycle.ignore_changes on the budget resource keeps this stable
# across subsequent plans.
budget_start_date  = "2026-05-01"
