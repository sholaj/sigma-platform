# ---------------------------------------------------------------------------
# Site-specific values. NOT committed with real data.
#
# Committed manifests carry neutral placeholders. scripts/render.sh rewrites
# them into ./.rendered/ at apply time. .rendered/ is gitignored.
#
# Placeholder -> real mapping. Fill the RIGHT-hand side locally only.
# ---------------------------------------------------------------------------

# VLAN IDs -------------------------------------------------------------------
NET_A_VLAN_PLACEHOLDER=100
NET_B_VLAN_PLACEHOLDER=101
NET_C_VLAN_PLACEHOLDER=102

NET_A_VLAN_REAL=100
NET_B_VLAN_REAL=101
NET_C_VLAN_REAL=102

# Subnet third-octet prefixes (e.g. 10.100.0 -> 10.203.0) ---------------------
NET_A_PREFIX_PLACEHOLDER=10.100.0
NET_B_PREFIX_PLACEHOLDER=10.101.0
NET_C_PREFIX_PLACEHOLDER=10.102.0

NET_A_PREFIX_REAL=10.100.0
NET_B_PREFIX_REAL=10.101.0
NET_C_PREFIX_REAL=10.102.0

# OVN localnet physical network name + host bridge ---------------------------
PHYSNET_PLACEHOLDER=physnet
PHYSNET_REAL=physnet

# Probe container image. Needs: nc (nmap-ncat), ip, awk.
# Phase 3 (air-gapped): replace with the mirrored equivalent from Nexus.
PROBE_IMAGE=registry.access.redhat.com/ubi9/ubi:latest

# RHEL 9 DataSource for the VM demo (namespace/name)
RHEL9_DATASOURCE_NS=openshift-virtualization-os-images
RHEL9_DATASOURCE_NAME=rhel9

# CUDN localnet segment (namespace-selector attach model) --------------------
NET_CUDN_VLAN_PLACEHOLDER=110
NET_CUDN_VLAN_REAL=110
NET_CUDN_PREFIX_PLACEHOLDER=10.110.0
NET_CUDN_PREFIX_REAL=10.110.0
